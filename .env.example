# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://bakachiki:bakachiki@localhost:5432/bakachiki?schema=public"

# ── Redis ────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── API ──────────────────────────────────────────────────
API_PORT=4000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"

# ── Auth (customer) ──────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Auth (admin) ─────────────────────────────────────────
ADMIN_JWT_ACCESS_SECRET="change-me-admin-access-secret"
ADMIN_JWT_ACCESS_EXPIRES_IN="15m"
ADMIN_JWT_REFRESH_SECRET="change-me-admin-refresh-secret"
ADMIN_JWT_REFRESH_EXPIRES_IN="7d"

# ── Seed super admin (used only by prisma/seed.ts) ───────
SEED_SUPER_ADMIN_EMAIL="admin@bakachiki.dev"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"

# ── Media storage ────────────────────────────────────────
# Leave the Cloudinary vars empty to use local-disk storage for development.
MEDIA_PROVIDER="local"           # "local" | "cloudinary" (auto-detected if Cloudinary vars are set)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Payments (PayU) ──────────────────────────────────────
# gtKFFx / eCwWELxi are PayU's published generic test-mode credentials
# (https://docs.payu.in/docs/test-integration) — fine for local dev; get a
# dedicated test key/salt from your own PayU dashboard for anything shared.
PAYU_MERCHANT_KEY="gtKFFx"
PAYU_MERCHANT_SALT="eCwWELxi"
PAYU_MODE="test"           # "test" | "live"

# ── Frontend (Nuxt) ──────────────────────────────────────
NUXT_PUBLIC_API_BASE="http://localhost:4000"
